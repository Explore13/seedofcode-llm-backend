NODE_ENV=development

# PROD Database Config (NeonDB)
PROD_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
PROD_DB_PORT=5432
PROD_DB_USER=your_user
PROD_DB_PASSWORD=your_password
PROD_DB_NAME=your_database
PROD_DB_SSL=true

# DEV Database Config (Local Postgres)
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_NAME=explorer
DEV_DB_SSL=false

# Redis Config (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=supersecretredis

# Auth Config
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Ollama Config
OLLAMA_HOST=http://127.0.0.1:11434

# Mail / OTP Config
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@seedofcode.dev
OTP_EXPIRY_MINUTES=5

# CORS Config
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://llm.seedofcode.com
